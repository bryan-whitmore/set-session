# Copy to .env, fill in, chmod 600. .env is gitignored.

# Tabular-RPC metadata endpoint.
VASTDB_ENDPOINT=http://10.0.0.1
VASTDB_ACCESS_KEY=
VASTDB_SECRET_KEY=
VASTDB_SSL_VERIFY=true

VASTDB_BUCKET=analytics
VASTDB_SCHEMA=bench
VASTDB_TABLE=events

# Optional. CNode URLs for QueryConfig.data_endpoints. Leave empty to use the
# session endpoint alone. Must be raw CNode IPs: the data path addresses
# endpoints virtual-host style, so a hostname label is read as a bucket name.
VASTDB_DATA_ENDPOINTS=http://10.0.0.1,http://10.0.0.2,http://10.0.0.3,http://10.0.0.4,http://10.0.0.5,http://10.0.0.6
